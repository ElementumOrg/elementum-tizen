{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Only ES lib is limited to Chrome 56 (Tizen 4) / Chromium 53 (webOS 4.x, the floor); the DOM lib is the latest, so these are NOT type-checked.
    // ES2017.Object types Object.values/entries/getOwnPropertyDescriptors, but Chromium 53 lacks them (src/polyfills.ts covers values/entries):
    // no AbortController (Chrome 66), no flex `gap` (Chrome 84), no import.meta.url,
    // no code-splitting (the iife bundle inlines import()).
    "lib": ["ES2016", "ES2017.Object", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // norigin-spatial-navigation imports React types; @preact/preset-vite aliases react to preact/compat at build time.
    "paths": { "react": ["./node_modules/preact/compat/"] },
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
